  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tra\xE7\xE3o Extra em Ladeiras: Supera o desafio f\xEDsico das inclina\xE7\xF5es
    mais severas (como as ladeiras de 30 graus) de forma automatizada, permitindo
    que o personagem avance sem exaust\xE3o total dentro do tempo limite.\n\nMapa
    em Tempo Real (GPS Acess\xEDvel): Mostra na interface uma rota verde limpa, indicando
    o caminho livre de guias altas e bloqueios urbanos, exigindo escolha estrat\xE9gica
    de rota.\n\n\"Subir uma ladeira de 30 graus aos 72 anos no bra\xE7o n\xE3o \xE9
    exerc\xEDcio, \xE9 castigo. Liga o chip.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 125cb55b44b24c4393181402bc6200e6, type: 2}
