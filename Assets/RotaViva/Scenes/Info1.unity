  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypewriterEffect
  targetText: {fileID: 930252907}
  textToType: "Como funciona no jogo: D\xE1 tra\xE7\xE3o extra para vencer ladeiras
    e mostra no mapa a rota verde livre de escadas e bloqueios em tempo real.\n\nFrase
    da Cidade (Rodap\xE9): \"Subir uma ladeira de 30 graus aos 72 anos no bra\xE7o
    n\xE3o \xE9 exerc\xEDcio, \xE9 castigo. Liga o chip.\""
  audioSource: {fileID: 930252909}
  typeSound: {fileID: 8300000, guid: 0ce07eaedc06435489b68ec71677e4ae, type: 3}
  letterDelay: 0.03
  shakeIntensity: 3
