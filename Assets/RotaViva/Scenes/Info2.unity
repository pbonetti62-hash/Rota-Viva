  m_Script: {fileID: 11500000, guid: e7f62bde58e5c594781e82d68d2045d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypewriterEffect
  targetText: {fileID: 930252907}
  textToType: "Como funciona no jogo: O cart\xE3o de acesso serve para escanear leitores
    em paredes urbanas, abrindo port\xF5es de atalho exclusivos (destinados a carrinhos
    de beb\xEA e necessidades especiais) que permitem cruzar para o outro lado de
    trechos fechados da rua.\n\nFrase da Cidade (Rodap\xE9): \"Cal\xE7ada quebrada,
    canteiro de obras bloqueando o caminho e o rel\xF3gio correndo para deixar o
    L\xE9o na creche. Encontre o desvio.\""
  audioSource: {fileID: 930252909}
  typeSound: {fileID: 8300000, guid: 0ce07eaedc06435489b68ec71677e4ae, type: 3}
  letterDelay: 0.03
  shakeIntensity: 3
